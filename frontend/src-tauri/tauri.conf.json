{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Auto-Ripper",
  "version": "0.1.0",
  "identifier": "com.autorippr.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Auto-Ripper",
        "width": 1460,
        "height": 940,
        "minWidth": 1180,
        "minHeight": 760,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/README.txt",
      "resources/backend",
      "resources/config"
    ],
    "icon": ["icons/icon.ico"]
  }
}
